{
  "model": "anki_review.note",
  "pk": 137,
  "fields": {
    "guid": "82bcb567-d4fe-4e2d-aa1f-54e8ddbed577",
    "deck": 6,
    "question": "Rayons particuliers d'une lentille",
    "reponse": "<ul><li>Le rayon incident passant par le centre optique n'est pas dévié.\r\n<img src=\"5e957a6822f549a98d5fae33e999fd83.png\" alt=\"\">\r\n</li><li>Le rayon incident dont la droite support passe par le foyer objet de la lentille est dévié parallèlement à l'axe optique.\r\n<img src=\"e748ad3150d24646a402cdde7936d1b3.png\" alt=\"\">\r\n</li><li>Le rayon incident parallèle à l'axe optique est dévié de façon à ce que sa droite support passe par le foyer image de la lentille.\r\n<img src=\"f6b5f26e41ba46eca90843f4e47c7a34.png\" alt=\"\"></li></ul>",
    "tags": "Chap.3",
    "modifie_le": "2026-09-22T14:42:08.579Z",
    "cree_par": [
      "yohan.poirier@hotmail.fr"
    ],
    "partagee_avec_classe": true,
    "note_miroir": null
  }
},
