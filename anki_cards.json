  "pk": 134,
  "fields": {
    "guid": "666bae20-bf17-4177-86b8-f65270c7e512",
    "deck": 6,
    "question": "Aplanétisme (définition)",
    "reponse": "Propriété d'un système optique permettant d'obtenir d'un objet plan perpendiculaire à l'axe optique, une image plane perpendiculaire à l'axe optique.\r\n\r\n<img src=\"5793dcd612984766a41ae51933677b29.png\" alt=\"\">",
    "tags": "Chap.2",
    "modifie_le": "2026-09-22T14:15:10.714Z",
    "cree_par": [
