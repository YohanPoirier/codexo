{
  "model": "anki_review.note",
  "pk": 117,
  "fields": {
    "guid": "91220295-2b48-4ce6-9621-538b0dafc046",
    "deck": 6,
    "question": "Lois de Snell-Descartes",
    "reponse": "<img src=\"798f9e25cee643bfb18c980536034b75.png\" alt=\"\">\r\n<ul><li>le rayon réfracté et le rayon réfléchi sont contenus dans le plan d'incidence,</li><li>l'angle de réflexion et l'angle d'incidence sont reliés par :\r\n\t\\[\r\n\t\ti_1 = -  r\r\n\t\\]</li><li>l'angle de réfraction et l'angle d'incidence sont reliés par :\r\n\t\\[\r\n\t\tn_1 \\sin i_1 = n_2 \\sin i_2\r\n\t\\]</li></ul>",
    "tags": "Chap.1",
    "modifie_le": "2026-09-22T09:53:11.735Z",
    "cree_par": [
      "yohan.poirier@hotmail.fr"
    ],
    "partagee_avec_classe": true,
    "note_miroir": null
  }
},
