{
  "model": "anki_review.note",
  "pk": 143,
  "fields": {
    "guid": "3cb1726d-bdd7-4c18-bcb2-004007367f81",
    "deck": 6,
    "question": "Grandissement transversal (relations)",
    "reponse": "Avec origine au centre :\r\n\\[\\gamma = \\frac{\\overline{OA'}}{\\overline{OA}}\\]\r\nAvec origine aux foyers :\r\n\\[\\gamma = \\frac{\\overline{F'A'}}{\\overline{F'O}}= \\frac{\\overline{FO}}{\\overline{FA}}\\]",
    "tags": "Chap.3",
    "modifie_le": "2026-09-22T14:37:29.595Z",
    "cree_par": [
      "yohan.poirier@hotmail.fr"
    ],
    "partagee_avec_classe": true,
    "note_miroir": null
  }
},
{
  "model": "anki_review.note",
  "pk": 144,
  "fields": {
    "guid": "e1b76a49-15b3-4f5a-acdf-54648163c2cf",
    "deck": 6,
    "question": "Relations de conjugaison",
    "reponse": "Relation de conjugaison de Descartes :\r\n\\[\\frac{1}{\\overline{OA'}}-\\frac{1}{\\overline{OA}}=\\frac{1}{f'}\\]\r\nRelation de conjugaison de Newton :\r\n\\[\\overline{F'A'}\\cdot \\overline{FA}=-f'^2\\]",
    "tags": "Chap.3",
    "modifie_le": "2026-09-22T14:39:33.796Z",
    "cree_par": [
      "yohan.poirier@hotmail.fr"
    ],
    "partagee_avec_classe": true,
    "note_miroir": null
  }
},
