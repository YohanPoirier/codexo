  "pk": 135,
  "fields": {
    "guid": "9c2b67e4-7aed-4d0e-97e9-97d35fd57c07",
    "deck": 6,
    "question": "Conditions de Gauss",
    "reponse": "Utilisation d'un système optique avec uniquement des rayons <b>paraxiaux</b>, c'est-à-dire :\r\n<ul><li>des rayons <b>peu inclinés</b> par rapport à l’axe optique,</li><li>des rayons <b>proches</b> de l'axe optique.</li></ul>",
    "tags": "Chap.2",
    "modifie_le": "2026-09-22T14:17:10.745Z",
    "cree_par": [
      "yohan.poirier@hotmail.fr"
    ],
    "partagee_avec_classe": true,
    "note_miroir": null
  }
},
